# Copiar a deploy/.env y completar.
# Topología split: 2 VMs Micro (eduscout-db y eduscout-app).
#  - VM eduscout-db (161.153.203.115): SOLO necesita DATABASE_USER/PASSWORD/NAME
#  - VM eduscout-app (144.22.42.169, IP pública reservada): necesita el .env completo
#
# NOTA: ADMIN_PASSWORD, ADMIN_TOKEN_SECRET y CANDIDATE_TOKEN_SECRET son
# OBLIGATORIOS (el compose falla al iniciar si faltan; no hay defaults).

DATABASE_USER=eduscout
DATABASE_PASSWORD=cambiar-por-una-password-fuerte-sin-caracteres-especiales
DATABASE_NAME=eduscout

# Backups cifrados (gpg AES256). SOLO en la VM eduscout-db.
# Generar: openssl rand -hex 48 > deploy/.backup-gpg-passphrase && chmod 600 deploy/.backup-gpg-passphrase
GPG_PASSPHRASE_FILE=${GPG_PASSPHRASE_FILE:-/opt/eduscout/deploy/.backup-gpg-passphrase}
BACKUP_DIR=${BACKUP_DIR:-/opt/eduscout/backups}
RETENTION_DAYS=${RETENTION_DAYS:-7}

# Fase 2a aprobada: scraping desde Oracle validado (12/12 fuentes OK desde el VPS)
SCRAPING_CRON_ENABLED=true

# Para rollback apuntar a un SHA concreto, p. ej. ghcr.io/bguzmanm/eduscout-back:<sha>
BACKEND_IMAGE=ghcr.io/bguzmanm/eduscout-back:latest
FRONTEND_IMAGE=ghcr.io/bguzmanm/eduscout-front:latest

DOMAIN=eduscout.cl

# Autenticación admin (obligatorio, sin default)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=definir-password-fuerte-sin-caracteres-especiales
ADMIN_TOKEN_SECRET=generar-con-openssl-rand-hex-32
ADMIN_TOKEN_TTL_MS=7200000

# Autenticación postulante (obligatorio, sin default)
CANDIDATE_TOKEN_SECRET=generar-con-openssl-rand-hex-32
CANDIDATE_TOKEN_TTL_MS=604800000

# Telegram (informes de scraping y comandos del bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Correo SMTP (recuperación de contraseña de postulantes).
# SMTP_HOST vacío → los correos se loguean en consola (no apto para prod).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EduScout <no-reply@eduscout.cl>

# URL pública del frontend (para los enlaces de recuperación)
FRONTEND_URL=https://eduscout.cl
