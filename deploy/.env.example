# Copiar a deploy/.env y completar
DATABASE_USER=eduscout
DATABASE_PASSWORD=cambiar-por-una-password-fuerte-sin-caracteres-especiales
DATABASE_NAME=eduscout

# En Fase 2a (scraping en Oracle) pasar a true
SCRAPING_CRON_ENABLED=false

# Para rollback apuntar a un SHA concreto, p. ej. ghcr.io/bguzmanm/eduscout-back:<sha>
BACKEND_IMAGE=ghcr.io/bguzmanm/eduscout-back:latest
FRONTEND_IMAGE=ghcr.io/bguzmanm/eduscout-front:latest

DOMAIN=eduscout.cl